# ── VibeML 环境变量模板 ─────────────────────────────────────────────────────
#   cp .env.example .env   然后按需修改
#
# 只跑核心功能（对话式 AutoML + 本地 Ollama）的话，这个文件全部留空也能用。
# 下面的配置只在启用账号体系 / 系统托管 LLM / Google 登录时才需要。

# ── 账号体系（可选）────────────────────────────────────────────────────────
# 不配置则账号功能不可用，但对话和训练照常工作。
# 本地起一个 Postgres：
#   docker run -d --name vibeml_pg -p 55432:5432 \
#     -e POSTGRES_USER=vibeml -e POSTGRES_PASSWORD=vibeml_dev_pw \
#     -e POSTGRES_DB=vibeml postgres:16
DATABASE_URL=postgresql+psycopg://vibeml:vibeml_dev_pw@localhost:55432/vibeml

# ⚠ 生产环境必须改掉。默认值仅供本地开发，泄露等于任何人都能伪造登录态。
#   生成方法：python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=dev-only-insecure-secret-change-me
JWT_ACCESS_TOKEN_MINUTES=15
JWT_REFRESH_TOKEN_DAYS=30

# ── 系统托管 LLM（可选）────────────────────────────────────────────────────
# 配置后，登录用户可用平台额度而无需自带 Key。不配则该选项在界面上不可用。
# ⚠ 这是真金白银的生产机密，上线前建议改接密钥管理服务而不是放环境变量。
ANTHROPIC_SYSTEM_API_KEY=
SYSTEM_MANAGED_DEFAULT_MODEL=claude-sonnet-4-6
QUOTA_FREE_MONTHLY_CALLS=200

# ── Google OAuth（可选）────────────────────────────────────────────────────
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
GOOGLE_OAUTH_REDIRECT_URI=http://localhost:8000/api/auth/google/callback

# ── 服务配置 ──────────────────────────────────────────────────────────────
# 逗号分隔。⚠ 不要用 "*"：浏览器规范不允许通配符 origin 配合携带凭据的请求
CORS_ALLOWED_ORIGINS=http://localhost:8000,http://127.0.0.1:8000

# 桌面版打包时置为 true
IS_DESKTOP_BUILD=false
OFFLINE_GRACE_DAYS=7
